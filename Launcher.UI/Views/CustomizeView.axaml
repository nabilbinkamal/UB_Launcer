<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Launcher.Core.ViewModels"
             xmlns:conv="clr-namespace:Launcher.UI.Converters"
             xmlns:controls="using:Launcher.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="850"
             x:Class="Launcher.UI.Views.CustomizeView"
             x:DataType="vm:CustomizeViewModel">
    <UserControl.Resources>
        <conv:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
        <conv:OpaqueBitmapConverter x:Key="OpaqueBitmapConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="30 46 30 24" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="SKIN SELECTOR" Classes="PageTitle" Foreground="#00D9FF"/>
                <TextBlock Text="Choose your player skin and cape" Classes="PageSubtitle" Foreground="#89929B"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Apply cosmetics"
                    Classes="CreateInstanceButton"
                    Padding="20 9"
                    Command="{Binding ApplyCosmeticsCommand}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="24">
            <Border x:Name="PreviewPanel" Width="285" Classes="SkinPreviewPanel" Padding="16 14">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                    <Border Classes="SkinUsernamePill" HorizontalAlignment="Center" Padding="13 6">
                        <TextBlock Text="{Binding Username}" FontFamily="Minecraft" FontSize="16" Foreground="#C9D1D9"/>
                    </Border>
                    <Border Grid.Row="1" Classes="SkinPreviewStage">
                        <Grid>
                            <Ellipse Width="218"
                                     Height="218"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="False"
                                     Opacity="0.42"
                                     StrokeThickness="1">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#759CEBFF" Offset="0.34"/>
                                        <GradientStop Color="#244F9DFF" Offset="0.68"/>
                                        <GradientStop Color="#55FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse Width="166"
                                     Height="166"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="False"
                                     Opacity="0.24"
                                     Stroke="#7FCBFF"
                                     StrokeThickness="1"/>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Padding="8 5"
                                    CornerRadius="10"
                                    Background="#C0121D29"
                                    BorderBrush="#6A87DFFF"
                                    BorderThickness="1"
                                    IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="#DDFBFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE 3D"
                                               FontFamily="Poppins"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#DDF8FF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <controls:SkinPreviewControl x:Name="PlayerPreview"
                                                         Source="{Binding SkinPath}"
                                                         CapeSource="{Binding CapePath}"
                                                         IsSlim="{Binding UseSlimModel}"
                                                         IsAnimated="True"
                                                         IsInteractive="True"
                                                         Margin="14"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="↔  Drag to rotate"
                               FontFamily="Poppins"
                               FontSize="12"
                               Foreground="#A5AFB8"
                               HorizontalAlignment="Center"/>
                    <Border Grid.Row="3" Padding="12 10">
                        <StackPanel Spacing="10">
                        <CheckBox Content="Slim Alex model"
                                  IsChecked="{Binding UseSlimModel}"
                                  Foreground="#D6DCE2"
                                  HorizontalAlignment="Center"/>
                        <Button Content="Reset cosmetics"
                                Classes="SkinResetButton"
                                HorizontalAlignment="Center"
                                Command="{Binding ResetCosmeticsCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="11">
                        <TextBlock Text="⌃  Saved skins" Classes="SkinSectionTitle" Foreground="#B7BEC6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="SkinAddTile"
                                        Width="190"
                                        Height="246"
                                        Click="OnBrowseSkinClick">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="+" FontFamily="Poppins" FontSize="34" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add skin" FontFamily="Poppins" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Browse PNG" FontFamily="Poppins" FontSize="11" Foreground="#9DA6AE" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding SavedSkins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkinLibraryItem">
                                            <Button Classes="SkinLibraryButton"
                                                    Classes.Selected="{Binding IsSelected}"
                                                    Width="190"
                                                    Height="245"
                                                    Command="{Binding $parent[UserControl].((vm:CustomizeViewModel)DataContext).SelectSavedSkinCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <controls:SkinPreviewControl Source="{Binding ImagePath}"
                                                                                 IsSlim="{Binding IsSlim}"
                                                                                 Zoom="1.30"
                                                                                 VerticalOffset="38"
                                                                                 Margin="0"/>
                                                    <Button Classes="SkinCardDeleteButton"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="12"
                                                            Command="{Binding $parent[UserControl].((vm:CustomizeViewModel)DataContext).DeleteSavedSkinCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="✕"
                                                                   FontFamily="Poppins"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Border Classes="SkinSelectedStroke"
                                                            IsVisible="{Binding IsSelected}"
                                                            IsHitTestVisible="False"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="11">
                        <TextBlock Text="⌃  Default skins" Classes="SkinSectionTitle" Foreground="#B7BEC6"/>
                        <ItemsControl ItemsSource="{Binding DefaultSkins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SkinLibraryItem">
                                    <Button Classes="SkinLibraryButton"
                                            Classes.Selected="{Binding IsSelected}"
                                            Width="190"
                                            Height="245"
                                            Margin="0 0 12 12"
                                            Command="{Binding $parent[UserControl].((vm:CustomizeViewModel)DataContext).SelectDefaultSkinCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <controls:SkinPreviewControl Source="{Binding ImagePath}"
                                                                         IsSlim="{Binding IsSlim}"
                                                                         Zoom="1.30"
                                                                         VerticalOffset="38"
                                                                         Margin="0"/>
                                            <Border Classes="SkinSelectedStroke"
                                                    IsVisible="{Binding IsSelected}"
                                                    IsHitTestVisible="False"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Owned capes (Microsoft account) — only shown when at least one cape is available -->
                    <StackPanel Spacing="11"
                                IsVisible="{Binding HasMicrosoftOwnedCapes}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⌃  Owned capes" Classes="SkinSectionTitle" Foreground="#B7BEC6"/>
                            <Border Background="#1A2A1A"
                                    BorderBrush="#2D5A2D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7 2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="♛"
                                               FontFamily="Poppins"
                                               FontSize="10"
                                               Foreground="#5EC95E"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Microsoft"
                                               FontFamily="Poppins"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#5EC95E"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MicrosoftOwnedCapes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CapeLibraryItem">
                                        <Button Classes="CapeLibraryButton"
                                                Classes.Selected="{Binding IsSelected}"
                                                Width="190"
                                                Height="245"
                                                ToolTip.Tip="{Binding Name}"
                                                Command="{Binding $parent[UserControl].((vm:CustomizeViewModel)DataContext).SelectOwnedCapeCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource OpaqueBitmapConverter}}"
                                                       Stretch="Uniform"
                                                       Width="122"
                                                       Height="176"
                                                       Margin="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                                <!-- Crown badge — bottom-right corner -->
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0 0 10 10"
                                                        Background="#CC1A2A1A"
                                                        BorderBrush="#2D5A2D"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="5 3"
                                                        IsHitTestVisible="False">
                                                    <TextBlock Text="♛"
                                                               FontFamily="Poppins"
                                                               FontSize="11"
                                                               Foreground="#5EC95E"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Classes="SkinSelectedStroke"
                                                        IsVisible="{Binding IsSelected}"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="11">
                        <TextBlock Text="⌃  Saved capes" Classes="SkinSectionTitle" Foreground="#B7BEC6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="SkinAddTile"
                                        Width="190"
                                        Height="245"
                                        Click="OnBrowseCapeClick">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="+" FontFamily="Poppins" FontSize="34" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add cape" FontFamily="Poppins" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Browse PNG" FontFamily="Poppins" FontSize="11" Foreground="#9DA6AE" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding SavedCapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CapeLibraryItem">
                                            <Button Classes="CapeLibraryButton"
                                                    Classes.Selected="{Binding IsSelected}"
                                                    Width="190"
                                                    Height="245"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding $parent[UserControl].((vm:CustomizeViewModel)DataContext).SelectSavedCapeCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource OpaqueBitmapConverter}}"
                                                           Stretch="Uniform"
                                                           Width="122"
                                                           Height="176"
                                                           Margin="0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
