<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:Launcher.Core.ViewModels" xmlns:controls="using:Launcher.UI.Controls" mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="900" x:Class="Launcher.UI.Views.PerformanceView" x:DataType="vm:PerformanceViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="32 28 32 36" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6"><TextBlock Text="Performance" Classes="WorkspacePageTitle"/><TextBlock Text="Monitor current system load and choose how Minecraft should use your PC." Classes="WorkspacePageDescription"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Border Width="8" Height="8" CornerRadius="4" Background="#52D28F" VerticalAlignment="Center"/><TextBlock Text="Live telemetry" Classes="WorkspaceLabel" Foreground="#72D9A1"/></StackPanel><TextBlock Text="{Binding CurrentLoadText}" Classes="WorkspaceSecondary" HorizontalAlignment="Right"/></StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Classes="ReadableMetricCard Cpu"><Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU usage" Classes="WorkspaceLabel"/><TextBlock Grid.Column="1" Text="Processor" Classes="WorkspaceSecondary"/></Grid><TextBlock Grid.Row="1" Text="{Binding CpuUsageText}" Classes="ReadableMetricValue"/><Border Grid.Row="2" Classes="ReadableChartSurface" Height="118"><Grid><controls:SparklineControl Height="100" Margin="10 9 38 9" AccentColor="#55B9FF" Values="{Binding CpuHistory}"/><Grid Width="30" Margin="0 9 8 9" HorizontalAlignment="Right" RowDefinitions="*,*,*"><TextBlock Text="100" Classes="ReadableAxisLabel" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="50" Classes="ReadableAxisLabel" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="0" Classes="ReadableAxisLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Grid></Border><TextBlock Grid.Row="3" Text="Last 60 seconds" Classes="ReadableChartCaption"/></Grid></Border>
                <Border Grid.Column="1" Classes="ReadableMetricCard Gpu"><Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="GPU usage" Classes="WorkspaceLabel"/><TextBlock Grid.Column="1" Text="Graphics" Classes="WorkspaceSecondary"/></Grid><TextBlock Grid.Row="1" Text="{Binding GpuUsageText}" Classes="ReadableMetricValue"/><Border Grid.Row="2" Classes="ReadableChartSurface" Height="118"><Grid><controls:SparklineControl Height="100" Margin="10 9 38 9" AccentColor="#9B84FF" Values="{Binding GpuHistory}"/><Grid Width="30" Margin="0 9 8 9" HorizontalAlignment="Right" RowDefinitions="*,*,*"><TextBlock Text="100" Classes="ReadableAxisLabel" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="50" Classes="ReadableAxisLabel" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="0" Classes="ReadableAxisLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Grid></Border><TextBlock Grid.Row="3" Text="Last 60 seconds" Classes="ReadableChartCaption"/></Grid></Border>
                <Border Grid.Column="2" Classes="ReadableMetricCard Memory"><Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Memory usage" Classes="WorkspaceLabel"/><TextBlock Grid.Column="1" Text="{Binding MemoryUsagePercentText}" Classes="WorkspaceValue" Foreground="#66D69A"/></Grid><TextBlock Grid.Row="1" Text="{Binding MemoryUsageText}" Classes="ReadableMetricValue Compact"/><Border Grid.Row="2" Classes="ReadableChartSurface" Height="118"><Grid><controls:SparklineControl Height="100" Margin="10 9 38 9" AccentColor="#51D59A" Values="{Binding MemoryHistory}"/><Grid Width="30" Margin="0 9 8 9" HorizontalAlignment="Right" RowDefinitions="*,*,*"><TextBlock Text="100" Classes="ReadableAxisLabel" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="50" Classes="ReadableAxisLabel" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="0" Classes="ReadableAxisLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Grid></Border><TextBlock Grid.Row="3" Text="Last 60 seconds" Classes="ReadableChartCaption"/></Grid></Border>
            </Grid>

            <Border Grid.Row="2" Classes="WorkspaceSection">
                <Grid ColumnDefinitions="250,*" ColumnSpacing="22">
                    <StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="Performance profile" Classes="WorkspaceSectionTitle"/><TextBlock Text="Choose a starting point. You can adjust individual options below." Classes="WorkspaceSecondary" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProfile, StringFormat='{}Selected: {0}'}" Classes="WorkspaceLabel" Foreground="#8DBAFF" Margin="0 6 0 0"/></StackPanel>
                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Classes="ReadablePreset" Classes.Active="{Binding IsEfficiencyProfile}" Command="{Binding SelectProfileCommand}" CommandParameter="Efficiency"><StackPanel Spacing="8"><TextBlock Text="Efficiency" Classes="ReadablePresetTitle"/><TextBlock Text="Use fewer resources on lower-end systems." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel></Button>
                        <Button Grid.Column="1" Classes="ReadablePreset" Classes.Active="{Binding IsBalancedProfile}" Command="{Binding SelectProfileCommand}" CommandParameter="Balanced"><StackPanel Spacing="8"><TextBlock Text="Balanced" Classes="ReadablePresetTitle"/><TextBlock Text="Smooth gameplay with sensible background usage." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel></Button>
                        <Button Grid.Column="2" Classes="ReadablePreset" Classes.Active="{Binding IsHighProfile}" Command="{Binding SelectProfileCommand}" CommandParameter="High"><StackPanel Spacing="8"><TextBlock Text="High" Classes="ReadablePresetTitle"/><TextBlock Text="Give Minecraft priority and reduce launch overhead." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel></Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,350" ColumnSpacing="18">
                <Border Classes="WorkspaceSection">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="5"><TextBlock Text="Optimization controls" Classes="WorkspaceSectionTitle"/><TextBlock Text="Changes save automatically and take effect the next time Minecraft launches." Classes="WorkspaceSecondary"/></StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Optimization pack" Classes="WorkspaceBody"/><TextBlock Text="Use recommended rendering and launch defaults." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableOptimizationPack}"/></Grid><Border Classes="WorkspaceDivider"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Windows game mode" Classes="WorkspaceBody"/><TextBlock Text="Prioritize Minecraft while it is running." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableGameMode}"/></Grid><Border Classes="WorkspaceDivider"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="High process priority" Classes="WorkspaceBody"/><TextBlock Text="Increase CPU scheduling priority for the game." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding UseHighProcessPriority}"/></Grid><Border Classes="WorkspaceDivider"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Force dedicated GPU" Classes="WorkspaceBody"/><TextBlock Text="Ensure the game uses your high-performance graphics card." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceDedicatedGpu}"/></Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="20">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Fast launch" Classes="WorkspaceBody"/><TextBlock Text="Reuse files that have already been verified." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFastLaunch}"/></Grid><Border Classes="WorkspaceDivider"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Hardware acceleration" Classes="WorkspaceBody"/><TextBlock Text="Use GPU-backed effects in the launcher." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHardwareAcceleration}"/></Grid><Border Classes="WorkspaceDivider"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Automatic optimization" Classes="WorkspaceBody"/><TextBlock Text="Apply safe recommendations automatically." Classes="WorkspaceSecondary" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOptimize}"/></Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="WorkspaceSection" VerticalAlignment="Top">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="System health" Classes="WorkspaceSectionTitle"/><TextBlock Grid.Column="1" Text="{Binding HealthStatus}" Classes="WorkspaceLabel" Foreground="{Binding HealthAccent}" VerticalAlignment="Center"/></Grid>
                        <StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU" Classes="WorkspaceBody"/><TextBlock Grid.Column="1" Text="{Binding CpuUsageText}" Classes="WorkspaceValue"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsage}" Height="6" Foreground="#55B9FF"/></StackPanel>
                        <StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="GPU" Classes="WorkspaceBody"/><TextBlock Grid.Column="1" Text="{Binding GpuUsageText}" Classes="WorkspaceValue"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding GpuUsage}" Height="6" Foreground="#9B84FF"/></StackPanel>
                        <StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Memory" Classes="WorkspaceBody"/><TextBlock Grid.Column="1" Text="{Binding MemoryUsagePercentText}" Classes="WorkspaceValue"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryUsagePercent}" Height="6" Foreground="#51D59A"/></StackPanel>
                        <TextBlock Text="{Binding RecommendationText}" Classes="WorkspaceSecondary" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding LastAnalyzedText}" Classes="WorkspaceSecondary" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Analyze" Classes="WorkspaceSecondary" Command="{Binding AnalyzeSystemCommand}"/></Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
