<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:Launcher.Core.ViewModels" mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="850" x:Class="Launcher.UI.Views.PerformanceView" x:DataType="vm:PerformanceViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,*" Margin="30 46 30 24" RowSpacing="18">
            <StackPanel Spacing="4"><TextBlock Text="PERFORMANCE" Classes="PageTitle" Foreground="#00D9FF"/><TextBlock Text="Tune launch speed, memory, and gameplay optimization" Classes="PageSubtitle" Foreground="#89929B"/></StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Classes="PerformanceStatCard" Padding="17"><StackPanel Spacing="4"><TextBlock Text="AVERAGE FPS" Classes="FormLabel" Foreground="#737981"/><TextBlock Text="245" FontFamily="Minecraft Ten" FontSize="28" Foreground="White"/><TextBlock Text="+34% optimized" FontFamily="Poppins" FontSize="10" Foreground="#69E788"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="PerformanceStatCard" Padding="17"><StackPanel Spacing="4"><TextBlock Text="LAUNCH TIME" Classes="FormLabel" Foreground="#737981"/><TextBlock Text="12.10s" FontFamily="Minecraft Ten" FontSize="28" Foreground="White"/><TextBlock Text="Fast launch enabled" FontFamily="Poppins" FontSize="10" Foreground="#87E3F2"/></StackPanel></Border>
                <Border Grid.Column="2" Classes="PerformanceStatCard" Padding="17"><StackPanel Spacing="4"><TextBlock Text="MEMORY" Classes="FormLabel" Foreground="#737981"/><TextBlock Text="8 GB" FontFamily="Minecraft Ten" FontSize="28" Foreground="White"/><TextBlock Text="Balanced allocation" FontFamily="Poppins" FontSize="10" Foreground="#87E3F2"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,360" ColumnSpacing="14">
                <Border Classes="PanelCard" Padding="19 17"><StackPanel Spacing="18"><TextBlock Text="OPTIMIZATION PROFILE" Classes="PanelTitle" Foreground="White"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="UB optimization pack" FontFamily="Poppins" FontSize="13" Foreground="White"/><TextBlock Text="Sodium, Lithium, memory and launch tuning" FontFamily="Poppins" FontSize="10" Foreground="#737981"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableOptimizationPack}"/></Grid><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Fast launch" FontFamily="Poppins" FontSize="13" Foreground="White"/><TextBlock Text="Reuse verified assets and libraries" FontFamily="Poppins" FontSize="10" Foreground="#737981"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFastLaunch}"/></Grid><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Windows game mode" FontFamily="Poppins" FontSize="13" Foreground="White"/><TextBlock Text="Prioritize Minecraft while running" FontFamily="Poppins" FontSize="10" Foreground="#737981"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableGameMode}"/></Grid></StackPanel></Border>
                <Border Grid.Column="1" Classes="PanelCard" Padding="19 17"><StackPanel Spacing="14"><TextBlock Text="MEMORY ALLOCATION" Classes="PanelTitle" Foreground="White"/><TextBlock Text="{Binding AllocatedRamGb, StringFormat='{}{0} GB RAM'}" FontFamily="Minecraft Ten" FontSize="24" Foreground="#87E3F2"/><Slider Minimum="2" Maximum="16" Value="{Binding AllocatedRamGb}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="Recommended: 6–8 GB for optimized instances." FontFamily="Poppins" FontSize="10" Foreground="#737981" TextWrapping="Wrap"/><Button Content="Apply performance" Classes="CreateInstanceButton" HorizontalAlignment="Stretch" Padding="0 11" Command="{Binding ApplyPerformanceCommand}"/><TextBlock Text="{Binding StatusText}" FontFamily="Poppins" FontSize="10" Foreground="#87E3F2" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
