<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.Core.ViewModels"
        xmlns:controls="using:Launcher.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="961"
        Width="1440"
        Height="961"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        x:Class="Launcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/UB.png"
        Title="UB Launcher"
        Background="#050505"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid x:Name="MainLayout" ColumnDefinitions="230,*" Background="{DynamicResource PageBrush}">
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="#18212A" BorderThickness="0 0 1 0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel x:Name="LogoStack" Grid.Row="0" Margin="28 34 22 1" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="/Assets/UB.png" Width="43" Height="38" Stretch="Uniform" Margin="0 -2 0 0"/>
                        <TextBlock Text="LAUNCHER" FontFamily="Minecraft Ten" FontSize="22" FontWeight="Medium" Foreground="#87E3F2" VerticalAlignment="Center" Margin="0 5 0 0"/>
                    </StackPanel>
                    <Border Height="1" Background="Transparent" Margin="0 14 0 0"/>
                </StackPanel>

                <StackPanel x:Name="SidebarNavigation" Grid.Row="1" Margin="30 0 21 0" Spacing="12">
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsHomeActive}" Command="{Binding NavigateHomeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/home.svg"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsInstanceActive}" Command="{Binding NavigateProfilesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/instance.svg"/>
                            <TextBlock Text="Instance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsModsActive}" Command="{Binding NavigateModsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/mods.svg"/>
                            <TextBlock Text="Content" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsCustomizeActive}" Command="{Binding NavigateCustomizeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/customize.svg"/>
                            <TextBlock Text="Customize" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsPerformanceActive}" Command="{Binding NavigatePerformanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/performance.svg"/>
                            <TextBlock Text="Performance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsCreateServerActive}" Command="{Binding NavigateCreateServerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/createserver.svg"/>
                            <TextBlock Text="Create server" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsSettingsActive}" Command="{Binding NavigateSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:SvgPathIcon Source="/Assets/settings.svg"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="ProfilePanel" Classes="ProfileCard" Grid.Row="2" Width="179" Height="109" HorizontalAlignment="Left" Margin="30 18 0 18">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Grid.RowSpan="2" Width="40" Height="40" CornerRadius="5" Background="#E9E9E9" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Bottom"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="Premium" Classes="PremiumLabel" Margin="0 2 0 0"/>
                        <TextBlock Grid.Column="2" Text="⌄" FontSize="20" Foreground="#DDE8F1" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" Margin="0 14 0 0">
                            <TextBlock Text="◉" Foreground="White" FontSize="15"/>
                            <TextBlock Text="♪" Foreground="White" FontSize="17"/>
                            <TextBlock Text="▶" Foreground="White" FontSize="14"/>
                            <TextBlock Text="◎" Foreground="White" FontSize="16"/>
                        </StackPanel>
                        <Border Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#090D12">
                            <Grid RowDefinitions="40,*" ColumnDefinitions="40,*,Auto">
                                <Border Width="40" Height="40" CornerRadius="5" Background="#E9E9E9"/>
                                <StackPanel Grid.Column="1" Margin="10 3 0 0" Spacing="1">
                                    <TextBlock Text="{Binding Username}" Classes="PlayerNameLabel" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Premium" Classes="PremiumLabel"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⌄" Classes="PlayerChevron"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="19" Margin="0 16 0 0">
                                    <controls:SvgPathIcon Source="/Assets/discord.svg" Width="23" Height="23"/>
                                    <controls:SvgPathIcon Source="/Assets/tiktok.svg" Width="23" Height="23"/>
                                    <controls:SvgPathIcon Source="/Assets/youtube.svg" Width="23" Height="23"/>
                                    <controls:SvgPathIcon Source="/Assets/web.svg" Width="23" Height="23"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="32,*" Background="{DynamicResource PageBrush}">
            <Border Grid.Row="0" Background="#050505" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Classes="WindowButton" ToolTip.Tip="Minimize" Click="OnMinimizeClick">
                            <TextBlock Text="−" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 -3 0 0"/>
                        </Button>
                        <Button Classes="WindowButton" ToolTip.Tip="Maximize" Click="OnMaximizeClick">
                            <TextBlock Text="□" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Classes="WindowButton CloseButton" ToolTip.Tip="Close" Click="OnCloseClick">
                            <TextBlock Text="×" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 -2 0 0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding Navigation.CurrentView}"/>
        </Grid>
    </Grid>
</Window>
