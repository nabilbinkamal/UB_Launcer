<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Launcher.Core.ViewModels"
        xmlns:controls="using:Launcher.UI.Controls"
        xmlns:views="using:Launcher.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="961"
        Width="1440"
        Height="961"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        x:Class="Launcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/UB.png"
        Title="UB Launcher"
        Background="#050505"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid>
        <Grid x:Name="MainLayout" ColumnDefinitions="230,*" Background="{DynamicResource PageBrush}"
          Classes.ModalOpen="{Binding IsAnyModalOpen}"
          Opacity="{Binding MainContentOpacity}">
        <Grid.Styles>
            <Style Selector="Grid.ModalOpen">
                <Setter Property="Effect">
                    <BlurEffect Radius="10"/>
                </Setter>
            </Style>
        </Grid.Styles>
        <Border x:Name="Sidebar" Classes="SidebarGlass" Grid.Column="0" Background="#000000">
            <Grid RowDefinitions="98,*,Auto">
                <StackPanel x:Name="LogoStack" Grid.Row="0" Margin="33 11 20 0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="/Assets/UB.png" Width="56" Height="56" Stretch="Uniform"
                               IsVisible="{Binding !HasRemoteLogoImage}"/>
                        <controls:RemoteImage SourceUrl="{Binding RemoteLogoImageUrl}" Width="56" Height="56" Stretch="Uniform"
                                              DecodePixelWidth="512" IsVisible="{Binding HasRemoteLogoImage}"/>
                        <TextBlock Text="LAUNCHER" FontFamily="Minecraft Ten" FontSize="22" FontWeight="Medium" Foreground="#87E3F2" VerticalAlignment="Center" Margin="0 12 0 0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SidebarNavigation" Grid.Row="1" Margin="30 0 1 0" Spacing="12">
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsHomeActive}" Command="{Binding NavigateHomeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding HomeIconSource}"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsInstanceActive}" Command="{Binding NavigateProfilesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding InstanceIconSource}"/>
                            <TextBlock Text="Instance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsModsActive}" Command="{Binding NavigateModsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding ModsIconSource}"/>
                            <TextBlock Text="Content" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsCustomizeActive}" Command="{Binding NavigateCustomizeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding CustomizeIconSource}"/>
                            <TextBlock Text="Customize" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsPerformanceActive}" Command="{Binding NavigatePerformanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding PerformanceIconSource}"/>
                            <TextBlock Text="Performance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsCreateServerActive}" Command="{Binding NavigateCreateServerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding ServerIconSource}"/>
                            <TextBlock Text="Create server" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarButton" Classes.Active="{Binding IsSettingsActive}" Command="{Binding NavigateSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <controls:SvgPathIcon Source="{Binding SettingsIconSource}"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="ProfilePanel" Classes="ProfileCard" Grid.Row="2" Width="199" MinHeight="109" HorizontalAlignment="Left" Margin="30 18 0 18" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Border IsVisible="{Binding IsAccountMenuOpen}" Padding="8 10 8 8">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto" Margin="4 0 3 1">
                                    <TextBlock Text="SAVED ACCOUNTS" Classes="AccountMenuTitle"/>
                                    <Border Grid.Column="1" MinWidth="22" Height="18" Padding="6 0"
                                            Background="#122B3B" BorderBrush="#31566E" BorderThickness="1" CornerRadius="9"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SavedAccounts.Count}" FontFamily="Segoe UI" FontSize="10.5"
                                                   FontWeight="SemiBold" Foreground="#87E3F2"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SavedAccounts}" IsVisible="{Binding HasSavedAccounts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SavedAccountItem">
                                                <Grid ColumnDefinitions="*,28" ColumnSpacing="3">
                                                    <Button Classes="SavedAccountButton"
                                                            Classes.Active="{Binding IsActive}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSavedAccountCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="12,28,*" ColumnSpacing="7">
                                                        <Border Width="9" Height="9" CornerRadius="5" BorderBrush="#00D9FF" BorderThickness="1.25" VerticalAlignment="Center">
                                                            <Border Width="5" Height="5" CornerRadius="3" Background="#00D9FF" IsVisible="{Binding IsActive}"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="5" Background="#E3E5E6"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding Username}" Classes="PlayerNameLabel" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding AccountTypeLabel}" Classes="AccountOfflineStatus" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="SavedAccountDeleteButton"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteSavedAccountCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Delete saved account">
                                                        <TextBlock Text="×" FontSize="18" Foreground="#FF8B98" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="No saved accounts yet"
                                           IsVisible="{Binding !HasSavedAccounts}"
                                           FontFamily="Segoe UI" FontSize="10" Foreground="#77838E"
                                           HorizontalAlignment="Center" Margin="0 8"/>

                                <Button Classes="AddAccountButton" Command="{Binding AddAccountCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="+" FontFamily="Segoe UI" FontSize="14" Foreground="#E8EAEC" VerticalAlignment="Center" Margin="0 -2 0 0"/>
                                        <TextBlock Text="Add account" FontFamily="Segoe UI" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Height="1" Background="#273945" IsVisible="{Binding IsAccountMenuOpen}" Margin="9 0"/>

                        <Grid Grid.Row="2" Height="109" RowDefinitions="15,41,*,23,7">
                            <Button Grid.Row="1" Classes="ProfileToggleButton" Command="{Binding ToggleAccountMenuCommand}" Margin="11 0 10 0"
                                    AutomationProperties.Name="Account menu">
                                <Grid ColumnDefinitions="40,*,24" ColumnSpacing="3">
                                    <Border Width="40" Height="41" CornerRadius="5" Background="#E3E5E6"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Username}" Classes="PlayerNameLabel" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UserRank}" Classes="PremiumLabel"/>
                                    </StackPanel>
                                    <controls:SvgPathIcon Grid.Column="2" Source="/Assets/arrow-outlined.svg" Width="24" Height="12"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                                        <controls:SvgPathIcon.RenderTransform>
                                            <RotateTransform Angle="{Binding AccountArrowAngle}"/>
                                        </controls:SvgPathIcon.RenderTransform>
                                    </controls:SvgPathIcon>
                                </Grid>
                            </Button>

                            <Grid Grid.Row="3" ColumnDefinitions="23,*,23,*,23,*,23" Margin="11 0 12 0">
                                <Border Grid.Column="0" Classes="SocialIconHover" ToolTip.Tip="Discord">
                                    <controls:SvgPathIcon Source="{Binding DiscordIconSource}" Width="23" Height="23"/>
                                </Border>
                                <Border Grid.Column="2" Classes="SocialIconHover" ToolTip.Tip="TikTok">
                                    <controls:SvgPathIcon Source="{Binding TiktokIconSource}" Width="23" Height="23"/>
                                </Border>
                                <Border Grid.Column="4" Classes="SocialIconHover" ToolTip.Tip="YouTube">
                                    <controls:SvgPathIcon Source="{Binding YoutubeIconSource}" Width="23" Height="23"/>
                                </Border>
                                <Border Grid.Column="6" Classes="SocialIconHover" ToolTip.Tip="Website">
                                    <controls:SvgPathIcon Source="{Binding WebIconSource}" Width="23" Height="23"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="32,*" Background="Transparent">
            <Border Grid.Row="0" Classes="TitleBarGlass" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Classes="WindowButton" ToolTip.Tip="Minimize" Click="OnMinimizeClick">
                            <TextBlock Text="−" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 -3 0 0"/>
                        </Button>
                        <Button Classes="WindowButton" ToolTip.Tip="Maximize" Click="OnMaximizeClick">
                            <TextBlock Text="□" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Classes="WindowButton CloseButton" ToolTip.Tip="Close" Click="OnCloseClick">
                            <TextBlock Text="×" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 -2 0 0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <controls:NavigationHost Grid.Row="1"
                                     ItemsSource="{Binding Navigation.Views}"
                                     CurrentView="{Binding Navigation.CurrentView}"/>
        </Grid>
    </Grid>

        <Border Background="#75040709" IsVisible="{Binding IsSettingsOpen}">
            <views:SettingsView DataContext="{Binding Settings}"/>
        </Border>

        <Grid IsVisible="{Binding IsUpdatePopupVisible}" Background="#D205090D">
            <Border Background="#320B2030"/>

            <Border Width="630" MaxHeight="730" CornerRadius="26"
                    Background="#F60A1018" BorderBrush="#7894A9BC" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 28 80 4 #E0000000, 0 0 42 0 #402269FF">
                <Grid RowDefinitions="72,*">
                    <!-- Branded top rail -->
                    <Grid Margin="28 0" ColumnDefinitions="*,220,*">
                        <Border Height="1" Background="#294D6580" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="47" VerticalAlignment="Top"
                                Background="#0D151F" BorderBrush="#334E6375" BorderThickness="0 0 1 1"
                                CornerRadius="0 0 16 16">
                            <TextBlock Text="UB Launcher" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                       Foreground="#53A8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" Height="1" Background="#294D6580" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="48 4 48 38" Spacing="0">
                            <!-- Neon download emblem -->
                            <Grid Width="154" Height="154" HorizontalAlignment="Center">
                                <Border Width="154" Height="154" CornerRadius="77" BorderBrush="#123D67A8" BorderThickness="1"
                                        BoxShadow="0 0 34 0 #43226FFF"/>
                                <Border Width="136" Height="136" CornerRadius="68" BorderBrush="#2A54A9FF" BorderThickness="2"/>
                                <Border Width="116" Height="116" CornerRadius="58" BorderBrush="#72A8F1FF" BorderThickness="5"
                                        Background="#18104176" BoxShadow="0 0 25 1 #804A9FFF"/>
                                <Grid Width="72" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="18" Height="44" CornerRadius="2" Background="#8FC9FF"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 6 0 0"/>
                                    <Path Width="54" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top"
                                          Margin="0 44 0 0" Fill="#8FC9FF" Stretch="Fill"
                                          Data="M 0,0 L 54,0 L 27,28 Z"/>
                                    <Border Height="5" Width="58" CornerRadius="3" Background="#75B9FF"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 72 0 0"
                                            BoxShadow="0 0 12 0 #704DA8FF"/>
                                </Grid>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#281014" BorderBrush="#FF4F5D" BorderThickness="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 16 2 0"
                                        BoxShadow="0 0 15 0 #72FF3548">
                                    <TextBlock Text="!" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="#FF5A67"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 -2 0 0"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding UpdatePopupHeading}" FontFamily="Segoe UI" FontSize="35" FontWeight="Bold"
                                       Foreground="#F6FAFF" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0 15 0 0"/>
                            <TextBlock Text="{Binding UpdateMessage}" FontFamily="Segoe UI" FontSize="15" LineHeight="23"
                                       Foreground="#B8C5D0" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="480" Margin="0 11 0 0"/>

                            <Border Background="#97101722" BorderBrush="#403A7CC6" BorderThickness="1" CornerRadius="10"
                                    Padding="20 15" Margin="0 25 0 0">
                                <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Current Version" FontFamily="Segoe UI" FontSize="14" Foreground="#B7C4CF"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledVersionText}" FontFamily="Segoe UI" FontSize="15"
                                               FontWeight="Bold" Foreground="#D8E1E8"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#26394857" Margin="0 13"/>
                                    <TextBlock Grid.Row="2" Text="Latest Version" FontFamily="Segoe UI" FontSize="14" Foreground="#B7C4CF"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatestVersionText}" FontFamily="Segoe UI" FontSize="15"
                                               FontWeight="Bold" Foreground="#73C1FF"/>
                                </Grid>
                            </Border>

                            <Button Command="{Binding OpenReleaseNotesCommand}"
                                    IsVisible="{Binding !IsMandatoryUpdate}"
                                    IsEnabled="{Binding HasReleaseNotesUrl}"
                                    HorizontalAlignment="Center" Margin="0 12 0 -8" Padding="12 7"
                                    Background="Transparent" BorderThickness="0" Foreground="#4CA5FF">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="What's New" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text=">" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Margin="0 -2 0 0"/>
                                </StackPanel>
                            </Button>

                            <Border CornerRadius="12" Margin="0 24 0 0" Padding="2"
                                    Background="#694ED7FF" BoxShadow="0 0 28 2 #804C8FFF">
                                <Button Command="{Binding OpenUpdateCommand}" IsEnabled="{Binding HasUpdateUrl}"
                                        Height="70" Padding="22 0" BorderBrush="#67DEFF" BorderThickness="1.5" CornerRadius="10"
                                        Foreground="White" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#125BE8" Offset="0"/>
                                            <GradientStop Color="#087EFF" Offset="0.48"/>
                                            <GradientStop Color="#164DD4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Width="500">
                                        <TextBlock Text=">" FontSize="24" Foreground="#80E4FF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="UPDATE NOW" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="&lt;" FontSize="24" Foreground="#80E4FF" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Border>

                            <Button Classes="UpdateExitButton" Width="196" Height="50" Margin="0 18 0 0"
                                    HorizontalAlignment="Center" Click="OnUpdateExitClick"
                                    IsVisible="{Binding IsMandatoryUpdate}" Content="EXIT LAUNCHER"
                                    />
                            <Button Classes="UpdateExitButton" Width="196" Height="50" Margin="0 18 0 0"
                                    HorizontalAlignment="Center" Command="{Binding DismissUpdateCommand}"
                                    IsVisible="{Binding !IsMandatoryUpdate}" Content="LATER"
                                    />

                            <TextBlock Text="This update is required to continue using UB Launcher."
                                       IsVisible="{Binding IsMandatoryUpdate}" FontFamily="Segoe UI" FontSize="10.5"
                                       Foreground="#7791A4" HorizontalAlignment="Center" Margin="0 14 0 0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsAccountDialogOpen}">
            <Button Classes="AccountModalBackdrop" Command="{Binding CloseAccountDialogCommand}"/>

            <Border Classes="AccountModalCard" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 24">
                        <StackPanel Spacing="5">
                            <TextBlock Text="ADD ACCOUNT" Classes="AccountModalTitle"/>
                            <TextBlock Text="Choose how you want to play Minecraft." Classes="AccountModalSubtitle"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="AccountModalCloseButton" Command="{Binding CloseAccountDialogCommand}" ToolTip.Tip="Close">
                            <TextBlock Text="×" FontFamily="Segoe UI" FontSize="21" Margin="0 -3 0 0"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel IsVisible="{Binding IsAccountChoiceVisible}" Spacing="18">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Button Classes="AccountChoiceButton Microsoft" Command="{Binding SignInWithMicrosoftCommand}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">
                                        <Border Classes="AccountChoiceIcon Microsoft" HorizontalAlignment="Left">
                                            <Grid Width="22" Height="22" RowDefinitions="*,*" ColumnDefinitions="*,*">
                                                <Border Grid.Row="0" Grid.Column="0" Background="#F25022" Margin="0,0,1,1" />
                                                <Border Grid.Row="0" Grid.Column="1" Background="#7FBA00" Margin="1,0,0,1" />
                                                <Border Grid.Row="1" Grid.Column="0" Background="#00A4EF" Margin="0,1,1,0" />
                                                <Border Grid.Row="1" Grid.Column="1" Background="#FFB900" Margin="1,1,0,0" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="Microsoft login" Classes="AccountChoiceTitle" Margin="0 18 0 0"/>
                                        <TextBlock Grid.Row="2" Text="Use your official Minecraft account through secure browser sign-in."
                                                   Classes="AccountChoiceDescription" Margin="0 7 0 0" TextWrapping="Wrap"/>
                                    </Grid>
                                </Button>

                                <Button Grid.Column="1" Classes="AccountChoiceButton Offline" Command="{Binding ShowOfflineAccountEntryCommand}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">
                                        <Border Classes="AccountChoiceIcon Offline" HorizontalAlignment="Left">
                                            <Grid Width="24" Height="24">
                                                <Border Width="9" Height="9" CornerRadius="5" Background="#EAF8FF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                <Border Width="19" Height="10" CornerRadius="5 5 3 3" Background="#EAF8FF" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="Offline account" Classes="AccountChoiceTitle" Margin="0 18 0 0"/>
                                        <TextBlock Grid.Row="2" Text="Create a local username and play without signing in online."
                                                   Classes="AccountChoiceDescription" Margin="0 7 0 0" TextWrapping="Wrap"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <Border Classes="AccountSecurityNote">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Text="✓" FontFamily="Segoe UI" FontSize="13" Foreground="#77CEFF" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="UB Launcher never asks for or stores your Microsoft password."
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#8CA0AE" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOfflineAccountEntryVisible}" Spacing="20">
                            <Button Classes="AccountBackButton" Command="{Binding ShowAccountChoicesCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="‹" FontFamily="Segoe UI" FontSize="20" Margin="0 -4 0 0"/>
                                    <TextBlock Text="Back" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Classes="OfflineAccountPanel">
                                <Grid ColumnDefinitions="62,*" ColumnSpacing="18">
                                    <Border Classes="AccountChoiceIcon Offline" Width="62" Height="62">
                                        <Grid Width="28" Height="28">
                                            <Border Width="11" Height="11" CornerRadius="6" Background="#EAF8FF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            <Border Width="23" Height="12" CornerRadius="6 6 3 3" Background="#EAF8FF" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="Offline account" Classes="AccountChoiceTitle"/>
                                        <TextBlock Text="This username is saved locally on this PC." Classes="AccountChoiceDescription"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="8">
                                <TextBlock Text="MINECRAFT USERNAME" Classes="AccountFieldLabel"/>
                                <TextBox Text="{Binding NewOfflineUsername}" Classes="AccountUsernameInput"
                                         PlaceholderText="Enter username" MaxLength="16"/>
                                <TextBlock Text="3–16 characters · letters, numbers, and underscores only"
                                           Classes="AccountModalSubtitle" FontSize="10.5"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AccountDialogStatus}" Classes="AccountStatusText"
                                       IsVisible="{Binding !!AccountDialogStatus}" TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Content="Cancel" Classes="AccountSecondaryButton" Command="{Binding CloseAccountDialogCommand}"/>
                                <Button Grid.Column="1" Content="Add offline account" Classes="AccountPrimaryButton" Command="{Binding SaveOfflineAccountCommand}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding AccountDialogStatus}" Classes="AccountStatusText"
                                   IsVisible="{Binding IsAccountChoiceVisible}" HorizontalAlignment="Center"
                                   Margin="0 226 0 0" TextWrapping="Wrap"/>

                        <!-- Microsoft device-code sign-in panel -->
                        <StackPanel IsVisible="{Binding IsMicrosoftSignInPanelVisible}" Spacing="20">

                            <!-- Header row: M icon + title + back button -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="AccountChoiceIcon Microsoft" Width="40" Height="40">
                                    <Grid Width="18" Height="18" RowDefinitions="*,*" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Background="#F25022" Margin="0,0,1,1" />
                                        <Border Grid.Row="0" Grid.Column="1" Background="#7FBA00" Margin="1,0,0,1" />
                                        <Border Grid.Row="1" Grid.Column="0" Background="#00A4EF" Margin="0,1,1,0" />
                                        <Border Grid.Row="1" Grid.Column="1" Background="#FFB900" Margin="1,1,0,0" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12 0 0 0" Spacing="1">
                                    <TextBlock Text="Microsoft sign-in" Classes="AccountChoiceTitle"/>
                                    <TextBlock Text="Sign in with your Microsoft account" Classes="AccountChoiceDescription"/>
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Browser Instruction -->
                            <Border Background="#0D1620" BorderBrush="#1E3348" BorderThickness="1" CornerRadius="10" Padding="18 24">
                                <StackPanel Spacing="16" HorizontalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Your browser should open automatically." FontFamily="Segoe UI" FontSize="13"
                                               Foreground="#A0B4C4" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Please log in there to continue." FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#77CEFF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status / spinner row -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HorizontalAlignment="Center">
                                <!-- Animated spinner — visible only while busy -->
                                <Border Width="16" Height="16" VerticalAlignment="Center"
                                        IsVisible="{Binding IsMicrosoftSignInBusy}"
                                        CornerRadius="8" BorderBrush="#00D9FF" BorderThickness="2">
                                    <Border.RenderTransformOrigin>50%, 50%</Border.RenderTransformOrigin>
                                    <Border.RenderTransform>
                                        <RotateTransform/>
                                    </Border.RenderTransform>
                                    <Border.Styles>
                                        <Style Selector="Border">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Border.Styles>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DeviceCodeStatus}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#8CA8BE"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !!DeviceCodeStatus}"/>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
