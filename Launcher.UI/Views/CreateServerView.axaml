<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:Launcher.Core.ViewModels" mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="850" x:Class="Launcher.UI.Views.CreateServerView" x:DataType="vm:CreateServerViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*" Margin="30 46 30 24" RowSpacing="18">
            <StackPanel Spacing="4"><TextBlock Text="CREATE SERVER" Classes="PageTitle" Foreground="#00D9FF"/><TextBlock Text="Build and manage local Minecraft servers" Classes="PageSubtitle" Foreground="#89929B"/></StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="14">
                <Border Classes="PanelCard" Padding="18 16">
                    <Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="YOUR SERVERS" Classes="PanelTitle" Foreground="White"/><TextBlock Grid.Column="1" Text="{Binding Servers.Count, StringFormat='{}{0} servers'}" FontFamily="Poppins" FontSize="11" Foreground="#737981"/></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding Servers}" Margin="0 14 0 0"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="InstanceCard" Padding="14" Margin="0 0 0 10"><Grid ColumnDefinitions="48,*,Auto"><Border Width="38" Height="38" CornerRadius="7" Background="#0D8FB5"><TextBlock Text="UB" FontFamily="Minecraft Ten" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontFamily="Poppins" FontSize="13" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding Version}" FontFamily="Poppins" FontSize="10" Foreground="#89929B"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Border Background="#142B1C" CornerRadius="10" Padding="8 4"><TextBlock Text="{Binding Status}" FontFamily="Poppins" FontSize="9" Foreground="#69E788"/></Border><Button Content="▶" Classes="InstancePlayButton"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                </Border>
                <Border Grid.Column="1" Classes="PanelCard" Padding="18 16">
                    <StackPanel Spacing="12"><TextBlock Text="SERVER SETUP" Classes="PanelTitle" Foreground="White"/><TextBlock Text="Server name" Classes="FormLabel" Foreground="#89929B"/><TextBox Text="{Binding ServerName}"/><TextBlock Text="Minecraft version" Classes="FormLabel" Foreground="#89929B"/><TextBox Text="{Binding MinecraftVersion}"/><TextBlock Text="Server type" Classes="FormLabel" Foreground="#89929B"/><ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding ServerType}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="6"><TextBlock Text="RAM (GB)" Classes="FormLabel" Foreground="#89929B"/><NumericUpDown Minimum="1" Maximum="32" Value="{Binding AllocatedRamGb}"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Port" Classes="FormLabel" Foreground="#89929B"/><NumericUpDown Minimum="1024" Maximum="65535" Value="{Binding ServerPort}"/></StackPanel></Grid><CheckBox Content="Online mode authentication" IsChecked="{Binding OnlineMode}" Foreground="White"/><Button Content="Create server" Classes="CreateInstanceButton" HorizontalAlignment="Stretch" Padding="0 12" Command="{Binding CreateServerCommand}"/><TextBlock Text="{Binding StatusText}" FontFamily="Poppins" FontSize="10" Foreground="#87E3F2" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
