<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Launcher.Core.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="860"
             x:Class="Launcher.UI.Views.CreateServerView"
             x:DataType="vm:CreateServerViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="32 28 32 36" RowDefinitions="Auto,Auto,*" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Minecraft servers" Classes="WorkspacePageTitle"/>
                    <TextBlock Text="Pick a version, press Start, and UB Launcher handles the setup." Classes="WorkspacePageDescription"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+  New server" Classes="WorkspacePrimary" Command="{Binding ShowCreatePanelCommand}" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" Classes="ServerActivityStrip">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#4C9BE8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="WorkspaceSecondary" Foreground="#9BC6E2" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="360,*" ColumnSpacing="18">
                <Border Classes="WorkspaceSection" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Your servers" Classes="WorkspaceSectionTitle"/>
                                <TextBlock Text="Choose one to play or manage." Classes="WorkspaceSecondary"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Servers.Count, StringFormat='{}{0} saved'}" Classes="WorkspaceSecondary" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Servers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalServerItem">
                                    <Button Classes="ServerListCard"
                                            Classes.Selected="{Binding IsSelected}"
                                            Margin="0 0 0 10"
                                            Padding="14"
                                            Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).SelectServerCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                                            <Border Width="44" Height="44" CornerRadius="10" Background="#153E54" BorderBrush="#285D79" BorderThickness="1">
                                                <TextBlock Text="UB" FontFamily="Minecraft Ten" FontSize="14" Foreground="#8BEAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontFamily="Inter" FontSize="15" FontWeight="SemiBold" Foreground="#F2F5F7" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Version, StringFormat='{}Minecraft {0}'}" Classes="WorkspaceSecondary" FontSize="12"/>
                                                <TextBlock Text="{Binding ServerType}" Classes="WorkspaceSecondary" Foreground="#7FA9C4" FontSize="12"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="ServerStatusPill" Classes.Running="{Binding IsRunning}" Classes.SetupRequired="{Binding IsSetupRequired}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Classes="WorkspaceBadgeText"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="WorkspaceSection ServerCreatorPanel" VerticalAlignment="Top" IsVisible="{Binding IsManagerVisible}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedServer.Name}" Classes="WorkspaceSectionTitle" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedServer.Endpoint}" Classes="WorkspaceSecondary" Foreground="#7FA9C4"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="ServerStatusPill" Classes.Running="{Binding SelectedServer.IsRunning}" Classes.SetupRequired="{Binding SelectedServer.IsSetupRequired}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedServer.Status}" Classes="WorkspaceBadgeText"/>
                            </Border>
                        </Grid>

                        <Border Classes="ServerHintCard">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,*,120" ColumnSpacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Minecraft version" Classes="WorkspaceLabel"/>
                                        <TextBox Text="{Binding EditMinecraftVersion}" Classes="WorkspaceField" IsEnabled="{Binding !SelectedServer.IsRunning}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <TextBlock Text="Server software" Classes="WorkspaceLabel"/>
                                        <ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding EditServerType}" Classes="WorkspaceField" IsEnabled="{Binding !SelectedServer.IsRunning}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="7">
                                        <TextBlock Text="RAM (GB)" Classes="WorkspaceLabel"/>
                                        <NumericUpDown Minimum="1" Maximum="32" Value="{Binding EditMemoryGb}" Classes="WorkspaceField" IsEnabled="{Binding !SelectedServer.IsRunning}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding AccountModeText}" Classes="WorkspaceLabel" Foreground="#68DDA8"/>
                                        <TextBlock Text="Offline mode is easier for friends, but usernames are not verified on public servers." Classes="WorkspaceSecondary" FontSize="10.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="Paper/Purpur automatically gets ViaVersion, ViaBackwards and ViaRewind." Classes="WorkspaceSecondary" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Software downloads automatically on Start" Classes="WorkspaceSecondary" Foreground="#82B5FF" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox Content="I accept the Minecraft server EULA"
                                          IsChecked="{Binding EditEulaAccepted}"
                                          IsVisible="{Binding !EditEulaAccepted}"
                                          FontFamily="Inter" FontSize="13" Foreground="#E7C783"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Button Classes="ServerPowerButton" Classes.Stop="{Binding SelectedServer.IsRunning}" Command="{Binding ToggleSelectedServerCommand}" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding SelectedServer.ActionLabel}" HorizontalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="1" Content="Open folder" Classes="WorkspaceSecondary" Command="{Binding OpenSelectedServerFolderCommand}"/>
                            <Button Grid.Column="2" Content="Delete server" Classes="WorkspaceDanger" Command="{Binding RequestDeleteSelectedServerCommand}"/>
                        </Grid>

                        <Border Classes="ServerSetupNotice" IsVisible="{Binding IsDeleteConfirmationVisible}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Delete this server permanently?" Classes="WorkspaceLabel" Foreground="#FF9AA7"/>
                                <TextBlock Text="The world, plugins, settings and all files in this server folder will be deleted. This cannot be undone." Classes="WorkspaceSecondary" FontSize="11.5" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Content="Cancel" Classes="WorkspaceSecondary" Command="{Binding CancelDeleteSelectedServerCommand}"/>
                                    <Button Grid.Column="1" Content="Yes, delete permanently" Classes="WorkspaceDanger" Command="{Binding ConfirmDeleteSelectedServerCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander Header="Share with friends" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Border Classes="ServerNetworkCard" Margin="0 10 0 0">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Same Wi-Fi / LAN" Classes="WorkspaceStatLabel" Foreground="#68DDA8"/>
                                            <TextBlock Text="{Binding LanJoinAddress}" Classes="ServerJoinAddress"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Copy" Classes="ServerActionButton" Click="CopyLanAddress_OnClick" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Classes="WorkspaceDivider"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Play from anywhere — UB Relay" Classes="WorkspaceStatLabel" Foreground="#82C7FF"/>
                                            <TextBlock Text="{Binding TunnelJoinAddress}" Classes="ServerJoinAddress" Foreground="#9BD9FF"/>
                                            <TextBlock Text="{Binding TunnelStatus}" Classes="WorkspaceSecondary" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                            <Button Content="{Binding TunnelActionLabel}" Classes="ServerActionButton RelayToggleButton" Classes.Stop="{Binding IsTunnelRunning}" Command="{Binding ToggleTunnelCommand}"/>
                                            <Button Content="Copy" Classes="ServerActionButton" Click="CopyTunnelAddress_OnClick"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="Plugin manager" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Border Classes="ServerNetworkCard" Margin="0 10 0 0">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Plugins" Classes="WorkspaceSectionTitle" FontSize="15"/>
                                            <TextBlock Text="{Binding PluginSupportText}" Classes="WorkspaceSecondary" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Open plugins folder" Classes="WorkspaceSecondary" Command="{Binding OpenPluginsFolderCommand}" IsVisible="{Binding IsPluginSupported}"/>
                                    </Grid>

                                    <StackPanel Spacing="7" IsVisible="{Binding IsPluginSupported}">
                                        <TextBlock Text="{Binding InstalledPlugins.Count, StringFormat='{}Installed ({0})'}" Classes="WorkspaceLabel"/>
                                        <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InstalledServerPlugin">
                                                    <Border Background="#0F171D" BorderBrush="#293844" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0 0 0 6">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Name}" Classes="WorkspaceLabel"/>
                                                                <TextBlock Text="{Binding FileName}" Classes="WorkspaceSecondary" FontSize="10.5"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Remove" Classes="WorkspaceDanger"
                                                                    Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePluginCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding !$parent[UserControl].((vm:CreateServerViewModel)DataContext).SelectedServer.IsRunning}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsPluginSupported}">
                                        <TextBox Text="{Binding PluginSearchQuery}" PlaceholderText="Search plugins, e.g. Essentials, WorldEdit..." Classes="WorkspaceField"/>
                                        <Button Grid.Column="1" Content="Search" Classes="WorkspacePrimary" Command="{Binding SearchPluginsCommand}" IsEnabled="{Binding !IsPluginBusy}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PluginStatusText}" Classes="WorkspaceSecondary" FontSize="11" TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{Binding PluginResults}" IsVisible="{Binding IsPluginSupported}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ServerPluginSearchItem">
                                                <Border Background="#0F171D" BorderBrush="#293844" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0 0 0 7">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" Classes="WorkspaceLabel"/>
                                                                <TextBlock Text="{Binding Author}" Classes="WorkspaceSecondary" FontSize="11"/>
                                                                <TextBlock Text="{Binding DownloadsLabel}" Classes="WorkspaceSecondary" FontSize="11" Foreground="#76A9C8"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" Classes="WorkspaceSecondary" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="ServerActionButton"
                                                                Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).InstallPluginCommand}"
                                                                CommandParameter="{Binding}" IsEnabled="{Binding CanInstall}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="Advanced settings" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0 12 0 0" Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="7"><TextBlock Text="Server name" Classes="WorkspaceLabel"/><TextBox Text="{Binding EditServerName}" Classes="WorkspaceField"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Port" Classes="WorkspaceLabel"/><NumericUpDown Minimum="1024" Maximum="65535" Value="{Binding EditPort}" Classes="WorkspaceField"/></StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="7"><TextBlock Text="Max players" Classes="WorkspaceLabel"/><NumericUpDown Minimum="1" Maximum="200" Value="{Binding EditMaxPlayers}" Classes="WorkspaceField"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="View distance" Classes="WorkspaceLabel"/><NumericUpDown Minimum="2" Maximum="32" Value="{Binding EditViewDistance}" Classes="WorkspaceField"/></StackPanel>
                                </Grid>
                                <StackPanel Spacing="7"><TextBlock Text="Message of the day" Classes="WorkspaceLabel"/><TextBox Text="{Binding EditMotd}" Classes="WorkspaceField"/></StackPanel>
                                <StackPanel Spacing="7"><TextBlock Text="Launch JAR" Classes="WorkspaceLabel"/><TextBox Text="{Binding EditLaunchJarName}" Classes="WorkspaceField"/></StackPanel>
                                <CheckBox Content="Only allow premium / Microsoft-authenticated accounts" IsChecked="{Binding EditOnlineMode}" FontFamily="Inter" FontSize="13" Foreground="#D3D8DC"/>
                                <CheckBox Content="I accept the Minecraft server EULA" IsChecked="{Binding EditEulaAccepted}" FontFamily="Inter" FontSize="13" Foreground="#D3D8DC"/>
                                <Button Content="Save advanced settings" Classes="WorkspacePrimary" Command="{Binding SaveSelectedServerCommand}" IsEnabled="{Binding !SelectedServer.IsRunning}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Server console" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0 12 0 0" Spacing="10">
                                <Border Classes="ServerConsoleSurface">
                                    <ScrollViewer Height="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding SelectedServer.LogText}" Classes="ServerConsoleText" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding ConsoleCommand}" PlaceholderText="Type a server command..." Classes="WorkspaceField ServerConsoleInput" IsEnabled="{Binding SelectedServer.IsRunning}" KeyDown="ConsoleCommand_OnKeyDown"/>
                                    <Button Grid.Column="1" Content="Send" Classes="WorkspacePrimary" Command="{Binding SendConsoleCommandCommand}" IsEnabled="{Binding SelectedServer.IsRunning}"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="WorkspaceSection ServerCreatorPanel" VerticalAlignment="Top" IsVisible="{Binding IsCreatePanelVisible}">
                    <StackPanel Spacing="18" MaxWidth="560" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Create a server" Classes="WorkspaceSectionTitle"/>
                                <TextBlock Text="Just choose the basics. UB Launcher downloads and starts everything for you." Classes="WorkspaceSecondary" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cancel" Classes="WorkspaceSecondary" Command="{Binding CancelCreateCommand}"/>
                        </Grid>
                        <StackPanel Spacing="7"><TextBlock Text="Server name" Classes="WorkspaceLabel"/><TextBox Text="{Binding ServerName}" Classes="WorkspaceField"/></StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="7"><TextBlock Text="Minecraft version" Classes="WorkspaceLabel"/><TextBox Text="{Binding MinecraftVersion}" Classes="WorkspaceField"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Server software" Classes="WorkspaceLabel"/><ComboBox ItemsSource="{Binding ServerTypes}" SelectedItem="{Binding ServerType}" Classes="WorkspaceField"/></StackPanel>
                        </Grid>
                        <StackPanel Spacing="7"><TextBlock Text="RAM (GB)" Classes="WorkspaceLabel"/><NumericUpDown Minimum="1" Maximum="32" Value="{Binding AllocatedRamGb}" Classes="WorkspaceField"/></StackPanel>
                        <Border Classes="ServerHintCard">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Paper is recommended" Classes="WorkspaceLabel" Foreground="#68DDA8"/>
                                <TextBlock Text="It supports plugins and automatically includes ViaVersion, ViaBackwards and ViaRewind. Offline/cracked accounts are allowed by default." Classes="WorkspaceSecondary" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="Vanilla is the official server, but it cannot use plugins." Classes="WorkspaceSecondary" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <CheckBox Content="I accept the Minecraft server EULA" IsChecked="{Binding NewServerEulaAccepted}" FontFamily="Inter" FontSize="14" Foreground="#D3D8DC"/>
                        <Button Content="Create &amp; start server" Classes="WorkspacePrimary" HorizontalAlignment="Stretch" Command="{Binding CreateServerCommand}"/>
                        <TextBlock Text="On first start the server software and default compatibility plugins download automatically." Classes="WorkspaceSecondary" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
