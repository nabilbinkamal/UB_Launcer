<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Launcher.Core.ViewModels"
             xmlns:controls="using:Launcher.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="860"
             x:Class="Launcher.UI.Views.ModsView"
             x:DataType="vm:ModsViewModel">
    <Grid Margin="32 28 32 28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="Discover content" Classes="WorkspacePageTitle"/>
                    <TextBlock Text="Find compatible modpacks, mods, resource packs, data packs, and shaders." Classes="WorkspacePageDescription"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Sources" Classes="WorkspaceSecondary" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SourcesText}" Classes="WorkspaceLabel" Foreground="#7DB2FF" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContentCategory">
                        <Button Content="{Binding Name}"
                                Classes="WorkspaceTab"
                                Classes.Active="{Binding IsSelected}"
                                Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).SelectCategoryCommand}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Classes="WorkspaceToolbar">
                <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Search content" Classes="WorkspaceLabel"/>
                        <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search compatible content" Classes="WorkspaceField"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding InstallTargetHeading}" Classes="WorkspaceLabel" Foreground="#7DB2FF"/>
                        <ComboBox ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding SelectedInstance}"
                                  Classes="WorkspaceField InstanceTargetPicker"
                                  IsVisible="{Binding !IsStandaloneModpackCategory}"
                                  PlaceholderText="Choose an instance">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameProfile">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Name}" FontFamily="Inter" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RuntimeLabel}" FontFamily="Inter" FontSize="14" Foreground="#8DBAFF"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Classes="WorkspaceField"
                                IsVisible="{Binding IsStandaloneModpackCategory}"
                                Padding="14 9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#17345B">
                                    <TextBlock Text="+" FontFamily="Inter" FontSize="18" Foreground="#8FC5FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="New standalone instance" FontFamily="Inter" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Minecraft and loader resolve automatically"
                                               Classes="WorkspaceSecondary" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompatibilityHeading}" Classes="WorkspaceSecondary"/>
                    <TextBlock Text="{Binding InstallCompatibilityText}" Classes="WorkspaceLabel" Foreground="#8DBAFF"/>
                    <TextBlock Text="·" Classes="WorkspaceSecondary"/>
                    <TextBlock Text="{Binding StatusText}" Classes="WorkspaceSecondary" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Classes="WorkspaceSecondary" Command="{Binding RefreshCommand}"/>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="*,220" ColumnSpacing="14">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Browse projects" Classes="WorkspaceSectionTitle" FontSize="16"/>
                    <TextBlock Text="{Binding ResultCountText}" Classes="WorkspaceSecondary"/>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          Classes="WorkspaceField WorkspaceSortField"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"/>
            </Grid>

            <ListBox Grid.Row="5"
                     ItemsSource="{Binding VisibleContent}"
                     Classes="ContentCatalogList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContentItem">
                        <Border Classes="WorkspaceContentCard" Margin="0 0 0 10" Padding="16">
                            <Grid ColumnDefinitions="74,*,184" ColumnSpacing="16">
                                <Border Width="72" Height="72" CornerRadius="12" Background="{Binding Accent}" BorderBrush="#30FFFFFF" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Mark}" FontFamily="Inter" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <controls:RemoteImage SourceUrl="{Binding IconUrl}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontFamily="Inter" FontSize="17" FontWeight="SemiBold" Foreground="#F1F3F4" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="by" Classes="WorkspaceSecondary"/>
                                        <TextBlock Text="{Binding Author}" Classes="WorkspaceLabel"/>
                                        <TextBlock Text="·" Classes="WorkspaceSecondary"/>
                                        <TextBlock Text="{Binding StoreLabel}" Classes="WorkspaceLabel" Foreground="#7DB2FF"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Classes="WorkspaceBody" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    <Border Grid.Row="3" Classes="WorkspaceTagSurface" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Tags}" Classes="WorkspaceTagText" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                                    </Border>
                                    <StackPanel Grid.Row="4" IsVisible="{Binding IsInstalling}" Spacing="5" Margin="0 3 18 0">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallProgress}" Height="5" Foreground="#3B82F6">
                                            <ProgressBar.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Value" Duration="0:0:0.18"/>
                                                </Transitions>
                                            </ProgressBar.Transitions>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding InstallStatus}" Classes="WorkspaceSecondary" Foreground="#8DBAFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                                    <Button Classes="WorkspaceInstallButton"
                                            Classes.Installed="{Binding IsInstalled}"
                                            Classes.Installing="{Binding IsInstalling}"
                                            IsEnabled="{Binding CanInstall}"
                                            Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).InstallCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding ActionLabel}"
                                                   FontFamily="Inter"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="2"><TextBlock Text="DOWNLOADS" Classes="WorkspaceStatLabel"/><TextBlock Text="{Binding Downloads}" Classes="WorkspaceValue"/></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="FOLLOWERS" Classes="WorkspaceStatLabel"/><TextBlock Text="{Binding Likes}" Classes="WorkspaceValue"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Updated, StringFormat='{}Updated {0}'}" Classes="WorkspaceSecondary" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="5" IsVisible="{Binding IsVersionPickerOpen}"
                    Background="#F20A1118" BorderBrush="#387DBA" BorderThickness="1"
                    CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="430" MaxHeight="310">
                <StackPanel Spacing="14">
                    <TextBlock Text="Choose Minecraft version" Classes="WorkspaceSectionTitle" FontSize="19"/>
                    <TextBlock Text="Select the version you want to install this modpack for."
                               Classes="WorkspaceSecondary" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VersionPickerItem.Name}" Classes="WorkspaceLabel" Foreground="#8DBAFF"/>
                    <ComboBox ItemsSource="{Binding InstallVersions}" SelectedItem="{Binding SelectedInstallVersion}"
                              Classes="WorkspaceField" HorizontalAlignment="Stretch"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Content="Cancel" Classes="WorkspaceSecondary" Command="{Binding CancelVersionPickerCommand}"/>
                        <Button Grid.Column="1" Content="Install selected version" Classes="WorkspaceInstallButton"
                                Command="{Binding ConfirmVersionInstallCommand}" IsEnabled="{Binding CanConfirmVersionInstall}"/>
                    </Grid>
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
