<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:Launcher.Core.ViewModels" mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="850" x:Class="Launcher.UI.Views.SettingsView" x:DataType="vm:SettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*" Margin="30 46 30 24" RowSpacing="18">
            <StackPanel Spacing="4"><TextBlock Text="SETTINGS" Classes="PageTitle" Foreground="#00D9FF"/><TextBlock Text="Configure launcher, Java, memory, and integrations" Classes="PageSubtitle" Foreground="#89929B"/></StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="14">
                <StackPanel Spacing="12">
                    <Border Classes="PanelCard" Padding="18 16"><StackPanel Spacing="14"><TextBlock Text="JAVA &amp; MEMORY" Classes="PanelTitle" Foreground="White"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Allocated memory" FontFamily="Poppins" FontSize="12" Foreground="White"/><TextBlock Text="Memory reserved for Minecraft" FontFamily="Poppins" FontSize="10" Foreground="#737981"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding AllocatedRamGb, StringFormat='{}{0} GB'}" FontFamily="Minecraft Ten" FontSize="19" Foreground="#87E3F2"/></Grid><Slider Minimum="{Binding MinRamGb}" Maximum="{Binding MaxRamGb}" Value="{Binding AllocatedRamGb}" IsSnapToTickEnabled="True" TickFrequency="1"/><TextBlock Text="Java executable path" Classes="FormLabel" Foreground="#89929B"/><TextBox Text="{Binding JavaRuntimePath}" PlaceholderText="Auto-detected Java path"/><TextBlock Text="JVM arguments" Classes="FormLabel" Foreground="#89929B"/><TextBox Text="{Binding CustomJvmArguments}" TextWrapping="Wrap" AcceptsReturn="True" Height="86"/></StackPanel></Border>
                    <Border Classes="PanelCard" Padding="18 16"><StackPanel Spacing="14"><TextBlock Text="INTEGRATIONS" Classes="PanelTitle" Foreground="White"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Discord Rich Presence" FontFamily="Poppins" FontSize="12" Foreground="White"/><TextBlock Text="Show the current instance and playtime" FontFamily="Poppins" FontSize="10" Foreground="#737981"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableDiscordRpc}"/></Grid><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="In-game overlay" FontFamily="Poppins" FontSize="12" Foreground="White"/><TextBlock Text="Enable the UB performance HUD" FontFamily="Poppins" FontSize="10" Foreground="#737981"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableOverlay}"/></Grid></StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12"><Border Classes="PanelCard" Padding="18 16"><StackPanel Spacing="12"><TextBlock Text="LAUNCHER" Classes="PanelTitle" Foreground="White"/><TextBlock Text="UB Launcher" FontFamily="Minecraft Ten" FontSize="22" Foreground="#87E3F2"/><TextBlock Text="Performance Edition" FontFamily="Poppins" FontSize="11" Foreground="#89929B"/><Border Height="1" Background="#2A2A2A"/><TextBlock Text="Game directory" Classes="FormLabel" Foreground="#89929B"/><TextBlock Text="%AppData%\UBLauncher\minecraft" FontFamily="Consolas" FontSize="10" Foreground="White" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="PanelCard" Padding="18 16"><StackPanel Spacing="10"><Button Content="Save &amp; apply" Classes="CreateInstanceButton" HorizontalAlignment="Stretch" Padding="0 11" Command="{Binding SaveSettingsCommand}"/><Button Content="Reset defaults" Classes="InstanceMoreButton" HorizontalAlignment="Stretch" Padding="0 11" Command="{Binding ResetToDefaultCommand}"/></StackPanel></Border></StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
