    </Style>
    <Style Selector="Button.CreateInstanceButton">
        <Setter Property="Background" Value="#1E58A5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3D82D9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14 8"/>
    </Style>
    <Style Selector="Button.CreateInstanceButton:pointerover">
