        <Setter Property="Background" Value="#173D2D"/><Setter Property="Foreground" Value="#D5F8E6"/><Setter Property="BorderBrush" Value="#398C67"/>
    </Style>
    <Style Selector="Border.SkinPreviewPanel">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
