        <Setter Property="Foreground" Value="#7F929F"/>
    </Style>
    <Style Selector="TextBlock.PerformanceMetricHint, TextBlock.PerformanceAxisLabel, TextBlock.PerformanceChartMeta">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="#7F909B"/>
    </Style>
    <Style Selector="TextBox.WorkspaceField">
        <Setter Property="PlaceholderForeground" Value="#8198A8"/>
    </Style>
    <Style Selector="ComboBox.WorkspaceField">
        <Setter Property="PlaceholderForeground" Value="#91A6B4"/>
    </Style>
    <Style Selector="TextBox.AccountUsernameInput">
        <Setter Property="PlaceholderForeground" Value="#8198A8"/>
    </Style>

    <!-- Figma Home frame 201:3 fidelity overrides. Keep these last so broader theme passes cannot override them. -->
    <Style Selector="Border.SidebarGlass">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Border.TitleBarGlass">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.SidebarButton">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.SidebarButton:pointerover">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.SidebarButton:pressed">
        <Setter Property="Background" Value="#105CD6"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active">
        <Setter Property="Background" Value="#105CD6"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active:pointerover">
        <Setter Property="Background" Value="#1766E5"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Border.ProfileCard">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#661C53A3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.ProfileCard:pointerover">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#801C63B5"/>
    </Style>
    <Style Selector="Border.SocialIconHover:pointerover">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>

    <Style Selector="Border.StatPill">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.HeroCard">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.HomePanel">
        <Setter Property="Background" Value="#081119"/>
        <Setter Property="BorderBrush" Value="#273C4A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.PartnerPanel">
        <Setter Property="Background" Value="#081119"/>
        <Setter Property="BorderBrush" Value="#273C4A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.PerformanceSummaryCard">
        <Setter Property="Background" Value="#081119"/>
        <Setter Property="BorderBrush" Value="#273C4A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.RecentInstancesPanel">
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.RecentServersPanel">
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.QuickActionsCard">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.CurrentInstanceCard">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#061621" Offset="0"/>
                <GradientStop Color="#071E2A" Offset="0.50"/>
                <GradientStop Color="#082A34" Offset="0.78"/>
                <GradientStop Color="#083E46" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="#244B5C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#2B176277" BlurRadius="14" Opacity="0.12" OffsetX="0" OffsetY="6"/>
        </Setter>
    </Style>
    <Style Selector="Border.MetricCard">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="BorderBrush" Value="#0DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.Tag">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.Tag > StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.Tag > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.InstanceEditButton">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.InstanceEditButton:pointerover">
        <Setter Property="Background" Value="#2600D9FF"/>
        <Setter Property="BorderBrush" Value="#4D00D9FF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.DetailsButton">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#14C0FF"/>
        <Setter Property="BorderBrush" Value="#0DFFFFFF"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.DetailsButton:pointerover">
        <Setter Property="Background" Value="#2600D9FF"/>
        <Setter Property="Foreground" Value="#00D9FF"/>
        <Setter Property="BorderBrush" Value="#4D00D9FF"/>
    </Style>
    <Style Selector="Button.QuickButton">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.QuickButton:pointerover">
        <Setter Property="Background" Value="#1A00D9FF"/>
        <Setter Property="Foreground" Value="#00D9FF"/>
        <Setter Property="BorderBrush" Value="#6600D9FF"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#4000D9FF" BlurRadius="10" Opacity="0.3" OffsetX="0" OffsetY="2"/>
        </Setter>
    </Style>
    <Style Selector="TextBlock.QuickActionsTitle">
        <Setter Property="RenderTransform">
            <TranslateTransform Y="-5"/>
        </Setter>
    </Style>
    <Style Selector="Button.RecentInstanceCard">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.RecentInstanceCard:pointerover">
        <Setter Property="Background" Value="#1800D9FF"/>
        <Setter Property="BorderBrush" Value="#6600D9FF"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#3300D9FF" BlurRadius="12" Opacity="0.4" OffsetX="0" OffsetY="3"/>
        </Setter>
    </Style>
    <Style Selector="Button.ServerRow, Button.RecentServerRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover, Button.RecentServerRow:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.RecentServerRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.ServerRow:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.RecentServerRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.PartnerPlayIcon">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover Border.PartnerPlayIcon, Button.RecentServerRow:pointerover Border.PartnerPlayIcon, Border.PartnerPlayIcon:pointerover">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover TextBlock.PartnerPlayIconText, Button.RecentServerRow:pointerover TextBlock.PartnerPlayIconText, Border.PartnerPlayIcon:pointerover TextBlock.PartnerPlayIconText">
        <Setter Property="Foreground" Value="#3C91E6"/>
    </Style>
    <Style Selector="Border.DiscordCard">
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Final readability pass for compact interactive controls. -->
    <Style Selector="Button.SidebarButton">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.SidebarButton TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.QuickButton">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.QuickButton TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.DetailsButton">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.DetailsButton TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.WorkspaceInlineButton">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.AccountPrimaryButton, Button.AccountSecondaryButton">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Plain Link Button (Zero hover box / zero borders) -->
    <Style Selector="Button.PlainLinkButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.PlainLinkButton:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.PlainLinkButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.PlainLinkButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Hide all scrollbars globally -->
    <Style Selector="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
    </Style>

    <!-- Final interaction polish: clear hover/pressed feedback for compact controls. -->
    <Style Selector="Button.ServerActionButton:pointerover">
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ServerActionButton:pressed">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Opacity" Value="0.86"/>
    </Style>
    <Style Selector="Button.ServerStartAction:pointerover">
        <Setter Property="Background" Value="#20A861"/>
        <Setter Property="BorderBrush" Value="#73E7A6"/>
    </Style>
    <Style Selector="Button.ServerRestartAction:pointerover">
        <Setter Property="Background" Value="#2C78CE"/>
        <Setter Property="BorderBrush" Value="#8BC8FF"/>
    </Style>
    <Style Selector="Button.ServerStopAction:pointerover">
        <Setter Property="Background" Value="#B6434D"/>
        <Setter Property="BorderBrush" Value="#FF9AA2"/>
    </Style>
    <Style Selector="Button.ServerKillAction:pointerover">
        <Setter Property="Background" Value="#422129"/>
        <Setter Property="BorderBrush" Value="#FF7180"/>
        <Setter Property="Foreground" Value="#FFD5D9"/>
    </Style>
    <Style Selector="Button.ServerListCard:pointerover">
        <Setter Property="Background" Value="#102638"/>
        <Setter Property="BorderBrush" Value="#55A9D8"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector="Button.QuickButton:pointerover">
        <Setter Property="Background" Value="#18354A"/>
        <Setter Property="BorderBrush" Value="#4CCBFF"/>
        <Setter Property="Foreground" Value="#EAF9FF"/>
    </Style>
    
    <!-- Modern ToggleSwitch without On/Off text -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="{x:Null}"/>
        <Setter Property="OffContent" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#1A2833"/>
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BoxShadow" Value="0 0 10 0 #40000000"/>
    </Style>
</Styles>

