<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#050505"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#030303"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#080808"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#141414"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2363B4"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#343434"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#87909A"/>
    </Styles.Resources>

    <Style Selector="Button.SidebarButton">
        <Setter Property="Width" Value="179"/>
        <Setter Property="Height" Value="39"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#F0F0F0"/>
        <Setter Property="BorderBrush" Value="#00FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14 0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.SidebarButton StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.SidebarButton TextBlock">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.WelcomeTitle">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.UserNameTitle">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.CurrentInstanceLabel">
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.InstanceNameLabel">
        <Setter Property="FontFamily" Value="Minecraft Ten"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.VersionLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.TagLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PanelTitle">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.QuickActionsTitle">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PremiumLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#87E3F2"/>
    </Style>
    <Style Selector="TextBlock.PlayerNameLabel">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.PlayerChevron">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#F3F6FB"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7 -5 0 0"/>
    </Style>
    <Style Selector="TextBlock.PlayerSocialIcon">
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.StatLabel">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.StatValue">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.SidebarButton:pointerover">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="BorderBrush" Value="#335D9CE8"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active">
        <Setter Property="Background" Value="#1E58A5"/>
        <Setter Property="BorderBrush" Value="#3379B8FF"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active:pointerover">
        <Setter Property="Background" Value="#2465B9"/>
        <Setter Property="BorderBrush" Value="#668BC7FF"/>
    </Style>

    <Style Selector="Button.WindowButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F1F4F8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.WindowButton:pointerover"><Setter Property="Background" Value="#1AFFFFFF"/></Style>
    <Style Selector="Button.WindowButton.CloseButton"><Setter Property="Foreground" Value="#F4F4F4"/></Style>
    <Style Selector="Button.WindowButton.CloseButton:pointerover"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Style>

    <Style Selector="Border.StatPill">
        <Setter Property="Width" Value="135"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="10 6"/>
    </Style>
    <Style Selector="Border.HeroCard">
        <Setter Property="Background" Value="#101C29"/>
        <Setter Property="BorderBrush" Value="#354B62"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Border.PanelCard">
        <Setter Property="Background" Value="#080808"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.PanelCard:nth-child(1)">
        <Setter Property="Grid.Row" Value="0"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.PanelCard:nth-child(2)">
        <Setter Property="Grid.Row" Value="1"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.DiscordCard">
        <Setter Property="Grid.Row" Value="2"/>
    </Style>
    <Style Selector="Border.CurrentInstanceCard">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C23A9ECB" Offset="0"/>
                <GradientStop Color="#00000000" Offset="0.27"/>
                <GradientStop Color="#29FFFFFF" Offset="0.84"/>
                <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.MetricCard">
        <Setter Property="Background" Value="#111111"/>
        <Setter Property="BorderBrush" Value="#252525"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12 7"/>
        <Setter Property="MinHeight" Value="76"/>
    </Style>
    <Style Selector="Border.Tag">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8 4"/>
    </Style>
    <Style Selector="Button.PlayButton">
        <Setter Property="Width" Value="432"/>
        <Setter Property="Background" Value="#1C53A3"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#3D82D9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="55"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.PlayLabel">
        <Setter Property="FontFamily" Value="Minecraft Ten"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton:pointerover"><Setter Property="Background" Value="#347CD2"/></Style>
    <Style Selector="Button.PlayButton:disabled"><Setter Property="Background" Value="#1C375D"/><Setter Property="Foreground" Value="#8EA0B7"/></Style>
    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Background" Value="#252525"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.ServerRow">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="31"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover"><Setter Property="Background" Value="#151515"/></Style>
    <Style Selector="Border.RecentCard">
