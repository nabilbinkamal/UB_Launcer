        <Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F8FAFD"/>
    </Style>
    <Style Selector="TextBlock.ContentByline">
        <Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#9AA5B4"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
