<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#030508" Offset="0"/>
            <GradientStop Color="#071019" Offset="0.52"/>
            <GradientStop Color="#03070B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FB06090D" Offset="0"/>
            <GradientStop Color="#F5081017" Offset="0.58"/>
            <GradientStop Color="#EE07121B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E80D151D" Offset="0"/>
            <GradientStop Color="#D9091118" Offset="0.62"/>
            <GradientStop Color="#C90A151E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0152430" Offset="0"/>
            <GradientStop Color="#E00D1B26" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassInsetBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E00E151C" Offset="0"/>
            <GradientStop Color="#C9091016" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DF121A22" Offset="0"/>
            <GradientStop Color="#C90D131A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E524587F" Offset="0"/>
            <GradientStop Color="#D9173C5D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2C73C9" Offset="0"/>
            <GradientStop Color="#1E58A5" Offset="0.64"/>
            <GradientStop Color="#174780" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B8BE2" Offset="0"/>
            <GradientStop Color="#2867B8" Offset="0.64"/>
            <GradientStop Color="#1D5594" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BlueBrush" Color="#2C73C9"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#65D9FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3B49"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#344A5C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8798A8"/>
    </Styles.Resources>

    <!-- Global Premium Button Transitions -->
    <Style Selector="Button">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>


    <Style Selector="Border.SidebarGlass">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
        <Setter Property="BorderBrush" Value="#2A3B49"/>
        <Setter Property="BorderThickness" Value="0 0 1 0"/>
    </Style>
    <Style Selector="Border.TitleBarGlass">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F4070A0E" Offset="0"/>
                <GradientStop Color="#E90A1118" Offset="0.58"/>
                <GradientStop Color="#F206090D" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="#24323E"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
    </Style>

    <Style Selector="Button.SidebarButton">
        <Setter Property="Width" Value="179"/>
        <Setter Property="Height" Value="39"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14 0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.SidebarButton StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.SidebarButton TextBlock">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="2"/>
        </Setter>
    </Style>
    <Style Selector="TextBlock.WelcomeTitle">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.UserNameTitle">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.CurrentInstanceLabel">
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.InstanceNameLabel">
        <Setter Property="FontFamily" Value="Minecraft Ten"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.VersionLabel">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.TagLabel">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PanelTitle">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.QuickActionsTitle">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PremiumLabel">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#87E3F2"/>
    </Style>
    <Style Selector="TextBlock.PlayerNameLabel">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.PlayerChevron">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#F3F6FB"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7 -5 0 0"/>
    </Style>
    <Style Selector="TextBlock.PlayerSocialIcon">
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.StatLabel">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.StatValue">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.SidebarButton:pointerover">
        <Setter Property="Background" Value="#2AFFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active">
        <Setter Property="Background" Value="#1E58A5"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active:pointerover">
        <Setter Property="Background" Value="#2868B8"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.WindowButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F1F4F8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.WindowButton:pointerover"><Setter Property="Background" Value="#5C24547A"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.WindowButton:pressed"><Setter Property="Background" Value="#314456"/></Style>
    <Style Selector="Button.WindowButton.CloseButton"><Setter Property="Foreground" Value="#F4F4F4"/></Style>
    <Style Selector="Button.WindowButton.CloseButton:pointerover"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Style>

    <Style Selector="Border.StatPill">
        <Setter Property="Width" Value="135"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="6 5"/>
    </Style>
    <Style Selector="Border.HeroCard">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Border.PanelCard">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.PanelCard:nth-child(1)">
        <Setter Property="Grid.Row" Value="0"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.PanelCard:nth-child(2)">
        <Setter Property="Grid.Row" Value="1"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.DiscordCard">
        <Setter Property="Grid.Row" Value="2"/>
    </Style>
    <Style Selector="Border.CurrentInstanceCard">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07131D" Offset="0"/>
                <GradientStop Color="#091A28" Offset="0.46"/>
                <GradientStop Color="#0B2D42" Offset="0.76"/>
                <GradientStop Color="#0D506A" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="#315D76"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#436CCBFF" BlurRadius="20" Opacity="0.16" OffsetX="0" OffsetY="8"/>
        </Setter>
    </Style>
    <Style Selector="Border.MetricCard">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="BorderBrush" Value="#0DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="-2 0"/>
        <Setter Property="Padding" Value="12 7"/>
        <Setter Property="MinHeight" Value="76"/>
    </Style>
    <Style Selector="TextBlock.MetricLabel">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#66FFFFFF"/>
    </Style>
    <Style Selector="Border.Tag">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.PlayButton">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#105CD6" Offset="0"/>
                <GradientStop Color="#0A42A0" Offset="0.55"/>
                <GradientStop Color="#072B6B" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="55"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#0044BB" BlurRadius="12" Opacity="0.3" OffsetX="0" OffsetY="2"/>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.PlayButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.PlayLabel">
        <Setter Property="FontFamily" Value="Minecraft Ten"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton:pointerover">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1A74FF" Offset="0"/>
                <GradientStop Color="#105CD6" Offset="0.55"/>
                <GradientStop Color="#0C4CB8" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#0088FF" BlurRadius="22" Opacity="0.85" OffsetX="0" OffsetY="3"/>
        </Setter>
    </Style>
    <Style Selector="Button.PlayButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1A74FF" Offset="0"/>
                <GradientStop Color="#105CD6" Offset="0.55"/>
                <GradientStop Color="#0C4CB8" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.PlayButton:pressed">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#08377C" Offset="0"/>
                <GradientStop Color="#052658" Offset="0.55"/>
                <GradientStop Color="#031A3D" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#D6E4FF"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Opacity" Value="0.88"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="#002266" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="1"/>
        </Setter>
    </Style>
    <Style Selector="Button.PlayButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#08377C" Offset="0"/>
                <GradientStop Color="#052658" Offset="0.55"/>
                <GradientStop Color="#031A3D" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#D6E4FF"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.PlayButton:disabled">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#105CD6" Offset="0"/>
                <GradientStop Color="#0A42A0" Offset="0.55"/>
                <GradientStop Color="#072B6B" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.PlayButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#105CD6" Offset="0"/>
                <GradientStop Color="#0A42A0" Offset="0.55"/>
                <GradientStop Color="#072B6B" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Background" Value="#252525"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.IconButton:pointerover"><Setter Property="Background" Value="#2B75C5"/><Setter Property="BorderBrush" Value="#9BD6FF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.IconButton:pressed"><Setter Property="Background" Value="#163E73"/></Style>
    <Style Selector="Button.InstanceEditButton">
        <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.InstanceEditButton:pointerover"><Setter Property="Background" Value="#24577F"/><Setter Property="BorderBrush" Value="#8BD0FF"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.InstanceEditButton:pressed"><Setter Property="Background" Value="#142333"/></Style>
    
    <!-- Server Management Tabs -->
    <Style Selector="Button.ServerTabButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#7FA9C4"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="0 0 0 2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ServerTabButton:pointerover">
        <Setter Property="Foreground" Value="#D0E3F0"/>
        <Setter Property="BorderBrush" Value="#3D5A70"/>
    </Style>
    <Style Selector="Button.ServerTabButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#3D5A70"/>
        <Setter Property="BorderThickness" Value="0 0 0 2"/>
        <Setter Property="TextBlock.Foreground" Value="#D0E3F0"/>
    </Style>
    <Style Selector="Button.ServerTabButton.Active">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4C9BE8"/>
    </Style>
    <Style Selector="Button.ServerTabButton.Active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#4C9BE8"/>
        <Setter Property="BorderThickness" Value="0 0 0 2"/>
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="ComboBox.HomeInstancePicker">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="4 0 9 0"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:dropdownopen">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:focus">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker /template/ Border#Background">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:focus /template/ Border#Background">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:dropdownopen /template/ Border#Background">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox.HomeInstancePicker:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="Background" Value="#071018"/>
        <Setter Property="BorderBrush" Value="#315F82"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0 8 0 0"/>
        <Setter Property="BoxShadow" Value="0 16 36 0 #B8000000"/>
    </Style>
    <Style Selector="Button.ServerRow">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="31"/><Setter Property="CornerRadius" Value="6"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.ServerRow:pressed"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.RecentInstanceCard">
        <Setter Property="MinHeight" Value="112"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
