<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#040609"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#06080B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#090D12"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#111820"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2363B4"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26313B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8493A3"/>
    </Styles.Resources>

    <Style Selector="Button.SidebarButton">
        <Setter Property="Width" Value="179"/>
        <Setter Property="Height" Value="39"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="#11171D"/>
        <Setter Property="Foreground" Value="#F0F0F0"/>
        <Setter Property="BorderBrush" Value="#202B35"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14 0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.SidebarButton StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.SidebarButton TextBlock">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="2"/>
        </Setter>
    </Style>
    <Style Selector="TextBlock.WelcomeTitle">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.UserNameTitle">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.CurrentInstanceLabel">
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.InstanceNameLabel">
        <Setter Property="FontFamily" Value="Minecraft Ten"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.VersionLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.TagLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PanelTitle">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.QuickActionsTitle">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PremiumLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#87E3F2"/>
    </Style>
    <Style Selector="TextBlock.PlayerNameLabel">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.PlayerChevron">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#F3F6FB"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7 -5 0 0"/>
    </Style>
    <Style Selector="TextBlock.PlayerSocialIcon">
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.StatLabel">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.StatValue">
        <Setter Property="FontFamily" Value="Minecraft"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.SidebarButton:pointerover">
        <Setter Property="Background" Value="#1A4D80"/>
        <Setter Property="BorderBrush" Value="#63B5F2"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active">
        <Setter Property="Background" Value="#1E58A5"/>
        <Setter Property="BorderBrush" Value="#4B88D4"/>
    </Style>
    <Style Selector="Button.SidebarButton.Active:pointerover">
        <Setter Property="Background" Value="#2867B8"/>
        <Setter Property="BorderBrush" Value="#6AA4E8"/>
    </Style>

    <Style Selector="Button.WindowButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F1F4F8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.WindowButton:pointerover"><Setter Property="Background" Value="#28445C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.WindowButton:pressed"><Setter Property="Background" Value="#314456"/></Style>
    <Style Selector="Button.WindowButton.CloseButton"><Setter Property="Foreground" Value="#F4F4F4"/></Style>
    <Style Selector="Button.WindowButton.CloseButton:pointerover"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Style>

    <Style Selector="Border.StatPill">
        <Setter Property="Width" Value="135"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Background" Value="#10161C"/>
        <Setter Property="BorderBrush" Value="#2A3641"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10 6"/>
    </Style>
    <Style Selector="Border.HeroCard">
        <Setter Property="Background" Value="#0B121A"/>
        <Setter Property="BorderBrush" Value="#2B4965"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Border.PanelCard">
        <Setter Property="Background" Value="#080C10"/>
        <Setter Property="BorderBrush" Value="#26313B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.PanelCard:nth-child(1)">
        <Setter Property="Grid.Row" Value="0"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.PanelCard:nth-child(2)">
        <Setter Property="Grid.Row" Value="1"/>
    </Style>
    <Style Selector="Grid#RightRail > Border.DiscordCard">
        <Setter Property="Grid.Row" Value="2"/>
    </Style>
    <Style Selector="Border.CurrentInstanceCard">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111E29" Offset="0"/>
                <GradientStop Color="#090D12" Offset="0.46"/>
                <GradientStop Color="#0D141B" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="#2D4152"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.MetricCard">
        <Setter Property="Background" Value="#0D1217"/>
        <Setter Property="BorderBrush" Value="#202B35"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12 7"/>
        <Setter Property="MinHeight" Value="76"/>
    </Style>
    <Style Selector="TextBlock.MetricLabel">
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#66FFFFFF"/>
    </Style>
    <Style Selector="Border.Tag">
        <Setter Property="Background" Value="#151B22"/>
        <Setter Property="BorderBrush" Value="#26323D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8 4"/>
    </Style>
    <Style Selector="Button.PlayButton">
        <Setter Property="Background" Value="#1C53A3"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#3D82D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="55"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.PlayLabel">
        <Setter Property="FontFamily" Value="Minecraft Ten"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PlayButton:pointerover"><Setter Property="Background" Value="#2B6FC2"/><Setter Property="BorderBrush" Value="#63A1E8"/></Style>
    <Style Selector="Button.PlayButton:pressed"><Setter Property="Background" Value="#184985"/></Style>
    <Style Selector="Button.PlayButton:disabled"><Setter Property="Background" Value="#1C375D"/><Setter Property="Foreground" Value="#8EA0B7"/></Style>
    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Background" Value="#252525"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.IconButton:pointerover"><Setter Property="Background" Value="#2B75C5"/><Setter Property="BorderBrush" Value="#9BD6FF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.IconButton:pressed"><Setter Property="Background" Value="#163E73"/></Style>
    <Style Selector="Button.InstanceEditButton">
        <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.InstanceEditButton:pointerover"><Setter Property="Background" Value="#24577F"/><Setter Property="BorderBrush" Value="#8BD0FF"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.InstanceEditButton:pressed"><Setter Property="Background" Value="#142333"/></Style>
    <Style Selector="Button.ServerRow">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4 2"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="31"/><Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.ServerRow:pointerover"><Setter Property="Background" Value="#1C3C59"/><Setter Property="BorderBrush" Value="#4D9BD5"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.ServerRow:pressed"><Setter Property="Background" Value="#0E1A25"/></Style>
    <Style Selector="Border.RecentCard">
        <Setter Property="Background" Value="#090D12"/><Setter Property="BorderBrush" Value="#222D37"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10"/>
    </Style>
    <Style Selector="Border.RecentCard:pointerover"><Setter Property="Background" Value="#101720"/><Setter Property="BorderBrush" Value="#315C84"/></Style>
    <Style Selector="Button.DetailsButton">
        <Setter Property="Background" Value="#0C1C29"/><Setter Property="Foreground" Value="#63C4FF"/><Setter Property="BorderBrush" Value="#20394D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11 5"/><Setter Property="FontSize" Value="10"/><Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.DetailsButton:pointerover"><Setter Property="Background" Value="#1B527A"/><Setter Property="BorderBrush" Value="#69C2FF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.QuickButton">
        <Setter Property="Height" Value="38"/><Setter Property="Background" Value="#11171D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#29343E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="11 6"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.QuickButton:pointerover"><Setter Property="Background" Value="#1B4D76"/><Setter Property="BorderBrush" Value="#64B8F2"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.QuickButton:pressed"><Setter Property="Background" Value="#102034"/></Style>
    <Style Selector="Border.DiscordCard">
        <Setter Property="Background" Value="#100B1E"/><Setter Property="BorderBrush" Value="#322060"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="MinHeight" Value="132"/>
    </Style>
    <Style Selector="Button.JoinButton">
        <Setter Property="Width" Value="106"/><Setter Property="Height" Value="31"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#AD3EF7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#8825EF"/><Setter Property="FontFamily" Value="Minecraft"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="0 4 0 0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.JoinButton:pointerover"><Setter Property="Background" Value="#228825EF"/><Setter Property="BorderBrush" Value="#C96BFF"/><Setter Property="Foreground" Value="#B768FF"/></Style>
    <Style Selector="Button.JoinButton:pressed"><Setter Property="Background" Value="#3A1760"/><Setter Property="BorderBrush" Value="#E1A2FF"/></Style>
    <Style Selector="Border.ProfileCard">
        <Setter Property="Padding" Value="11 13"/>
        <Setter Property="Background" Value="#080D12"/>
        <Setter Property="BorderBrush" Value="#3D1C53A3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.ProfileCard:pointerover"><Setter Property="Background" Value="#0C141C"/><Setter Property="BorderBrush" Value="#805486C5"/></Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontFamily" Value="Minecraft"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Border.InstanceCard">
        <Setter Property="Background" Value="#111111"/><Setter Property="BorderBrush" Value="#2E3740"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.InstanceCard:pointerover">
        <Setter Property="Background" Value="#151B22"/><Setter Property="BorderBrush" Value="#1E58A5"/>
    </Style>
    <Style Selector="TextBlock.InstanceCardTitle">
        <Setter Property="FontFamily" Value="Minecraft Ten"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.InstanceCardMeta">
        <Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.InstanceCardSmall">
        <Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.FormLabel">
        <Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.CreateInstanceButton">
        <Setter Property="Background" Value="#1E58A5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3D82D9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14 8"/>
    </Style>
    <Style Selector="Button.CreateInstanceButton:pointerover">
        <Setter Property="Background" Value="#367ED5"/><Setter Property="BorderBrush" Value="#9BD6FF"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.CreateInstanceButton:pressed"><Setter Property="Background" Value="#17447F"/><Setter Property="BorderBrush" Value="#4B85C5"/></Style>
    <Style Selector="Button.InstancePlayButton">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#1E58A5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3D82D9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.InstancePlayButton:pointerover">
        <Setter Property="Background" Value="#367ED5"/><Setter Property="BorderBrush" Value="#9BD6FF"/>
    </Style>
    <Style Selector="Button.InstancePlayButton:pressed"><Setter Property="Background" Value="#17447F"/></Style>
    <Style Selector="Button.InstanceMoreButton">
        <Setter Property="Background" Value="#1AFFFFFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#33FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9 7"/>
    </Style>
    <Style Selector="Button.InstanceMoreButton:pointerover">
        <Setter Property="Background" Value="#275A80"/><Setter Property="BorderBrush" Value="#80C9F8"/>
    </Style>
    <Style Selector="Button.InstanceMoreButton:pressed"><Setter Property="Background" Value="#142536"/></Style>
    <Style Selector="Border.UploadDropZone">
        <Setter Property="Background" Value="#0B1117"/><Setter Property="BorderBrush" Value="#35506A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.PreviewStage">
        <Setter Property="Background" Value="#080D12"/><Setter Property="BorderBrush" Value="#24394C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.PerformanceStatCard">
        <Setter Property="Background" Value="#0D1116"/><Setter Property="BorderBrush" Value="#2C4256"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.ModCard">
        <Setter Property="Background" Value="#111111"/><Setter Property="BorderBrush" Value="#2D2D2D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.ModCard:pointerover">
        <Setter Property="Background" Value="#151B22"/><Setter Property="BorderBrush" Value="#1E58A5"/>
    </Style>
    <Style Selector="Button.ContentTab">
        <Setter Property="Background" Value="#25272E"/>
        <Setter Property="Foreground" Value="#F0F3F7"/>
        <Setter Property="BorderBrush" Value="#40434B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="17 10"/>
        <Setter Property="FontFamily" Value="Poppins"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.ContentTab:pointerover">
        <Setter Property="Background" Value="#465B70"/><Setter Property="BorderBrush" Value="#A0D5FA"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ContentTab:pressed"><Setter Property="Background" Value="#202B37"/></Style>
    <Style Selector="Button.ContentTab.Active">
        <Setter Property="Background" Value="#164B3A"/><Setter Property="Foreground" Value="#28E485"/><Setter Property="BorderBrush" Value="#1E8B5F"/>
    </Style>
    <Style Selector="Button.ContentTab.Active:pointerover">
        <Setter Property="Background" Value="#1B6049"/><Setter Property="Foreground" Value="#62F3A7"/>
    </Style>
    <Style Selector="Button.ContentTab.Active:pressed"><Setter Property="Background" Value="#10402F"/></Style>
    <Style Selector="Border.ContentSearchBox">
        <Setter Property="Height" Value="42"/><Setter Property="Background" Value="#30323A"/><Setter Property="BorderBrush" Value="#3E414A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.ContentSearchBox TextBox">
        <Setter Property="Padding" Value="0 9 12 9"/>
    </Style>
    <Style Selector="Button.ContentFilterButton">
        <Setter Property="Height" Value="36"/><Setter Property="Background" Value="#363942"/><Setter Property="Foreground" Value="#B4BFCE"/><Setter Property="BorderBrush" Value="#424650"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="15 6"/><Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.ContentFilterButton:pointerover">
        <Setter Property="Background" Value="#516579"/><Setter Property="BorderBrush" Value="#A8D9FF"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ContentFilterButton:pressed"><Setter Property="Background" Value="#2C3540"/></Style>
    <Style Selector="TextBlock.ContentPageActive">
        <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#125637"/><Setter Property="Foreground" Value="#29E687"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="LineHeight" Value="36"/><Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.ContentPageNumber">
        <Setter Property="Foreground" Value="#AEB8C7"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Poppins"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Border.ContentResultCard">
        <Setter Property="MinHeight" Value="112"/><Setter Property="Background" Value="#272A31"/><Setter Property="BorderBrush" Value="#393D46"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Border.ContentResultCard:pointerover">
        <Setter Property="Background" Value="#2C3038"/><Setter Property="BorderBrush" Value="#4875A4"/>
    </Style>
