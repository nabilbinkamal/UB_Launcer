    </Style>
    <Style Selector="Button.DetailsButton">
        <Setter Property="Background" Value="#101C25"/><Setter Property="Foreground" Value="#46B3F6"/><Setter Property="Padding" Value="11 5"/><Setter Property="FontSize" Value="10"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.QuickButton">
        <Setter Property="Width" Value="276"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#1AFFFFFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1AFFFFFF"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="11 6"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.QuickButton:pointerover"><Setter Property="Background" Value="#2865B5"/></Style>
